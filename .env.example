# Copy to .env and fill in. Never commit the real .env.
APP_NAME="Manager Library API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL from the infra repo (service "db" on network manager-library_library-net).
# Use DB_HOST=127.0.0.1 if you run the API outside Docker.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=change-me
# Tables live in schema "library"; Laravel's migrations table stays in "public".
DB_SEARCH_PATH=library,public

# Stateless API: no database-backed sessions, cache or queues.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Auth (phase 2): JWT HS256, 8 hours. Use a long random string.
JWT_SECRET=
# Initial admin, created by the application at startup (never by SQL).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Cover storage directory (phase 3).
COVERS_DIR=storage/app/covers
